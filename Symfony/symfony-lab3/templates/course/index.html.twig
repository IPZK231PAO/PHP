{% extends 'base.html.twig' %}

{% block title %}Course Management{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Course Management</h1>

    <!-- Add New Course Form -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Add New Course</h5>
        </div>
        <div class="card-body">
            <form method="POST" action="{{ path('course_new') }}">
                <div class="row g-3">
                    <div class="col-md-6">
                        <input type="text" name="title" class="form-control" placeholder="Course Title" required>
                    </div>
                    <div class="col-md-4">
                        <input type="number" name="credits" class="form-control" placeholder="Credits" required>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-success w-100">Add Course</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Filter Courses</h5>
        </div>
        <div class="card-body">
            <form method="GET" action="{{ path('course_index') }}">
                <div class="row g-3">
                    <div class="col-md-6">
                        <input type="text" name="title" class="form-control" placeholder="Filter by title" 
                               value="{{ titleFilter }}">
                    </div>
                    <div class="col-md-4">
                        <input type="number" name="credits" class="form-control" placeholder="Filter by credits"
                               value="{{ creditsFilter }}">
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">Filter</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Pagination Controls -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <form method="GET" class="form-inline">
                <select name="itemsPerPage" class="form-select" onchange="this.form.submit()">
                    <option value="5" {% if itemsPerPage == 5 %}selected{% endif %}>5 per page</option>
                    <option value="10" {% if itemsPerPage == 10 %}selected{% endif %}>10 per page</option>
                    <option value="20" {% if itemsPerPage == 20 %}selected{% endif %}>20 per page</option>
                </select>
                <input type="hidden" name="title" value="{{ titleFilter }}">
                <input type="hidden" name="credits" value="{{ creditsFilter }}">
            </form>
        </div>
        <div class="text-muted">
            Page {{ currentPage }} of {{ totalPages }} ({{ totalItems }} total)
        </div>
    </div>

    <!-- Courses Table -->
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Courses List</h5>
        </div>
        <div class="card-body">
            {% if courses|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Title</th>
                                <th>Credits</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for course in courses %}
                            <tr>
                                <td>{{ course.title }}</td>
                                <td>{{ course.credits }}</td>
                                <td class="text-end">
                                    <!-- Edit Button -->
                                    <button class="btn btn-sm btn-warning me-2" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#editModal"
                                            data-id="{{ course.id }}"
                                            data-title="{{ course.title }}"
                                            data-credits="{{ course.credits }}">
                                        Edit
                                    </button>
                                    <button type="button" 
                                            class="btn btn-sm btn-danger delete-btn" 
                                            data-url="{{ path('course_delete', {'id': course.id}) }}">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item {% if currentPage == 1 %}disabled{% endif %}">
                            <a class="page-link" 
                               href="{{ path('course_index', {
                                   'page': currentPage - 1,
                                   'itemsPerPage': itemsPerPage,
                                   'title': titleFilter,
                                   'credits': creditsFilter
                               }) }}">
                                Previous
                            </a>
                        </li>
                        
                        {% for page in 1..totalPages %}
                            <li class="page-item {% if page == currentPage %}active{% endif %}">
                                <a class="page-link" 
                                   href="{{ path('course_index', {
                                       'page': page,
                                       'itemsPerPage': itemsPerPage,
                                       'title': titleFilter,
                                       'credits': creditsFilter
                                   }) }}">
                                    {{ page }}
                                </a>
                            </li>
                        {% endfor %}
                        
                        <li class="page-item {% if currentPage == totalPages %}disabled{% endif %}">
                            <a class="page-link" 
                               href="{{ path('course_index', {
                                   'page': currentPage + 1,
                                   'itemsPerPage': itemsPerPage,
                                   'title': titleFilter,
                                   'credits': creditsFilter
                               }) }}">
                                Next
                            </a>
                        </li>
                    </ul>
                </nav>
            {% else %}
                <div class="alert alert-info">No courses found. Please add your first course.</div>
            {% endif %}
        </div>
    </div>

    <div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Course</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="PUT" action="" id="editForm">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Title</label>
                            <input type="text" name="title" id="editTitle" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Credits</label>
                            <input type="number" name="credits" id="editCredits" class="form-control" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>

    document.getElementById('editModal').addEventListener('show.bs.modal', function(event) {
        const button = event.relatedTarget;
        const modalTitle = document.querySelector('.modal-title');
        document.getElementById('editForm').action = `/course/${button.dataset.id}/edit`;
        document.getElementById('editTitle').value = button.dataset.title;
        document.getElementById('editCredits').value = button.dataset.credits;
        modalTitle.textContent = `Edit Course: ${button.dataset.title}`;
    });


    document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            if (confirm('Are you sure you want to delete this course?')) {
                fetch(this.dataset.url, {
                    method: 'DELETE',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                }).then(response => {
                    if (response.redirected) {
                        window.location.href = response.url;
                    }
                });
            }
        });
    });
</script>
{% endblock %}