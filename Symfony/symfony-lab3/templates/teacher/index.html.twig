{% extends 'base.html.twig' %}

{% block title %}Teachers Management{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Teachers Management</h1>

    <!-- Add New Teacher Form -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Add New Teacher</h5>
        </div>
        <div class="card-body">
            <form method="POST" action="{{ path('teacher_new') }}">
                <div class="row g-3">
                    <div class="col-md-5">
                        <input type="text" name="name" class="form-control" placeholder="Full Name" required>
                    </div>
                    <div class="col-md-5">
                        <input type="text" name="department" class="form-control" placeholder="Department" required>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-success w-100">Add</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Filter Teachers</h5>
        </div>
        <div class="card-body">
            <form method="GET" action="{{ path('teacher_index') }}">
                <div class="row g-3">
                    <div class="col-md-5">
                        <input type="text" name="name" class="form-control" placeholder="Filter by name" 
                               value="{{ app.request.query.get('name') }}">
                    </div>
                    <div class="col-md-5">
                        <input type="text" name="department" class="form-control" placeholder="Filter by department"
                               value="{{ app.request.query.get('department') }}">
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">Filter</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Pagination Controls -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <form method="GET" class="form-inline">
                <select name="itemsPerPage" class="form-select" onchange="this.form.submit()">
                    <option value="5" {% if app.request.query.get('itemsPerPage', 10) == 5 %}selected{% endif %}>5 per page</option>
                    <option value="10" {% if app.request.query.get('itemsPerPage', 10) == 10 %}selected{% endif %}>10 per page</option>
                    <option value="20" {% if app.request.query.get('itemsPerPage', 10) == 20 %}selected{% endif %}>20 per page</option>
                </select>
                <input type="hidden" name="name" value="{{ app.request.query.get('name') }}">
                <input type="hidden" name="department" value="{{ app.request.query.get('department') }}">
            </form>
        </div>
        <div class="text-muted">
            Page {{ currentPage }} of {{ totalPages }} ({{ totalItems }} total)
        </div>
    </div>

    <!-- Teachers Table -->
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Teachers List</h5>
        </div>
        <div class="card-body">
            {% if teachers|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Name</th>
                                <th>Department</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for teacher in teachers %}
                            <tr>
                                <td>{{ teacher.name }}</td>
                                <td>{{ teacher.department }}</td>
                                <td class="text-end">
                                    <!-- Edit Button -->
                                    <button class="btn btn-sm btn-warning me-2" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#editModal"
                                            data-id="{{ teacher.id }}"
                                            data-name="{{ teacher.name }}"
                                            data-department="{{ teacher.department }}">
                                        Edit
                                    </button>
                                    
                                    <form method="DELETE" action="{{ path('teacher_delete', {'id': teacher.id}) }}" style="display:inline;">
                                        <input type="hidden" name="_method" value="DELETE">
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">
                                            Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Navigation -->
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item {% if currentPage == 1 %}disabled{% endif %}">
                            <a class="page-link" 
                               href="{{ path('teacher_index', {
                                   'page': currentPage - 1,
                                   'itemsPerPage': itemsPerPage,
                                   'name': app.request.query.get('name'),
                                   'department': app.request.query.get('department')
                               }) }}">
                                Previous
                            </a>
                        </li>
                        
                        {% for page in 1..totalPages %}
                            <li class="page-item {% if page == currentPage %}active{% endif %}">
                                <a class="page-link" 
                                   href="{{ path('teacher_index', {
                                       'page': page,
                                       'itemsPerPage': itemsPerPage,
                                       'name': app.request.query.get('name'),
                                       'department': app.request.query.get('department')
                                   }) }}">
                                    {{ page }}
                                </a>
                            </li>
                        {% endfor %}
                        
                        <li class="page-item {% if currentPage == totalPages %}disabled{% endif %}">
                            <a class="page-link" 
                               href="{{ path('teacher_index', {
                                   'page': currentPage + 1,
                                   'itemsPerPage': itemsPerPage,
                                   'name': app.request.query.get('name'),
                                   'department': app.request.query.get('department')
                               }) }}">
                                Next
                            </a>
                        </li>
                    </ul>
                </nav>
            {% else %}
                <div class="alert alert-info">No teachers found. Please add your first teacher.</div>
            {% endif %}
        </div>
    </div>

    <!-- Edit Modal -->
    <div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Teacher</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="PUT" action="" id="editForm">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input type="text" name="name" id="editName" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Department</label>
                            <input type="text" name="department" id="editDepartment" class="form-control" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>

    document.getElementById('editModal').addEventListener('show.bs.modal', function(event) {
        const button = event.relatedTarget;
        document.getElementById('editForm').action = `/teacher/${button.dataset.id}/edit`;
        document.getElementById('editName').value = button.dataset.name;
        document.getElementById('editDepartment').value = button.dataset.department;
    });
</script>
{% endblock %}